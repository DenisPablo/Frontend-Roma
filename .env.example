# ── Frontend Development (Vite) ─────────────────────────────────────────
# URL base para las peticiones HTTP del cliente.
# En desarrollo local con Vite proxy, se recomienda dejarlo vacío o '/api'
# para que el proxy redirija automáticamente a http://localhost:5183.
VITE_API_BASE_URL=/api

# ── Dokploy / Docker Deployment (Nginx Reverse Proxy) ───────────────────
# Puerto interno en el que escuchará el contenedor Nginx.
PORT=80

# URL del contenedor o servicio backend dentro de la red Docker de Dokploy.
# Nginx reenviará todas las peticiones que lleguen a /api/* hacia este endpoint.
API_URL=http://roma-backend:8080
