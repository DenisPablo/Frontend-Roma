server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # ── OWASP Top 10 Security Headers ─────────────────────────────────────
    # A05: Security Misconfiguration - Previene clickjacking
    add_header X-Frame-Options "SAMEORIGIN" always;
    # A05: Previene MIME-type sniffing
    add_header X-Content-Type-Options "nosniff" always;
    # A03: Injection - Filtro XSS en navegadores legacy
    add_header X-XSS-Protection "1; mode=block" always;
    # A01: Broken Access Control - Política de Referrer segura
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # A05: Restricción de APIs del dispositivo
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # A03: Content Security Policy estricta para PWA
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' http: https: ws: wss:; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self';" always;

    # ── Performance: Compresión Gzip para mobile PWA ──────────────────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # ── Proxy Inverso /api hacia el Backend ────────────────────────────────
    # Resiliente: resolución DNS en runtime con resolver Docker/DNS público
    # Evita que Nginx crashee al arrancar si el backend aún no está listo o cambia de IP
    location /api/ {
        resolver 127.0.0.11 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
        set $upstream_backend "${API_URL}";
        proxy_pass $upstream_backend;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 25M;

        # Manejo de fallos transitorios del backend
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        error_page 502 503 504 = @backend_down;
    }

    # Respuesta JSON estructurada si el backend no responde (en lugar del HTML 502 por defecto de Nginx)
    location @backend_down {
        default_type application/json;
        return 503 '{"status":503,"error":"BackendUnavailable","message":"El servicio backend no está disponible temporalmente o está reiniciando. Por favor, reintente en unos instantes."}';
    }

    # ── PWA Web Manifest (MIME type application/manifest+json obligatorio para Chromium/Brave) ──
    location ~* ^/(manifest\.json|manifest\.webmanifest)$ {
        default_type application/manifest+json;
        types {
            application/manifest+json json webmanifest;
        }
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── Service Worker PWA (/sw.js) ───────────────────────────────────────
    location = /sw.js {
        default_type application/javascript;
        types {
            application/javascript js;
        }
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Service-Worker-Allowed "/" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── Assets estáticos con hash en /assets/ (Cache agresivo + immutable) ─
    location ~* ^/assets/.*\.(?:css|js|woff2?|png|jpg|jpeg|gif|webp)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── Favicon e iconos raíz PWA (Cache corto, revalidable) ────────────────
    location ~* ^/(?:favicon\.ico|apple-touch-icon.*\.png|icon-.*\.png|logo\.svg)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── Fonts y SVG genéricos (Cache moderado) ──────────────────────────────
    location ~* \.(?:woff2?|eot|ttf|otf)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ── Fallback SPA para React Router / PWA ──────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
